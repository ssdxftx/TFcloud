# 应用
APP_ENV=production
APP_DEBUG=false
HTTP_ADDR=:8787
TZ=Asia/Shanghai

# 数据目录（容器内固定 /data，安装向导会把 APP_KEY 等密钥写到这里）
TF_DATA_DIR=./data
SQLITE_PATH=./data/tfcloud.db

# 安装向导自动生成，请勿手工修改
APP_KEY=
CREDENTIAL_KEY_VERSION=1
CREDENTIAL_FINGERPRINT_KEY=

# 会话与跨域
SESSION_SECURE=false
CORS_ALLOWED_ORIGINS=

# 后台任务
SIGN_WORKER_ENABLED=true
SIGN_WORKER_COUNT=2
SIGN_SCHEDULER_ENABLED=true
SIGN_SCHEDULER_INTERVAL_SECONDS=30
TIEBA_RETRY_WORKER_ENABLED=true
BILIBILI_LIVE_WORKER_ENABLED=true
BILIBILI_LIVE_WORKER_COUNT=2
MAIL_WORKER_ENABLED=true
MAINTENANCE_ENABLED=true
TASK_LOCK_TIMEOUT_SECONDS=7200
